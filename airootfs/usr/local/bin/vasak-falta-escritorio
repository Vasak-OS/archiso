#!/usr/bin/env bash
#
# ¿Hay algo en la pantalla?
#
# Va como `ExecCondition=` de `vasak-sin-escritorio.service`: sale 0 cuando
# **no** hay escritorio —y entonces la unidad corre— y 1 cuando sí lo hay, que
# para systemd es saltear la unidad sin marcarla como fallida.
#
# El caso que atrapa es el que el `OnFailure=` de greetd no atrapa: greetd
# arrancando bien, tomando la sesión en vivo, esa sesión muriéndose, greetd
# cayendo al saludador y el saludador tampoco pudiendo dibujar. greetd sigue
# «activo» todo el tiempo y la pantalla está negra igual.
#
# # Por qué se equivoca para el lado seguro
#
# Equivocarse acá tiene dos costos muy distintos. Decir «no hay escritorio»
# cuando sí lo hay le roba la consola a alguien que estaba trabajando: rompe un
# arranque que funcionaba. Decir «sí hay» cuando no lo hay deja las cosas como
# estaban, que es de donde venimos. Así que ante la duda, se calla.
#
# De ahí las tres concesiones:
#
#   - Vale cualquier sesión del asiento que sea gráfica **o** del saludador. El
#     saludador de greetd es lo que se ve mientras nadie entró, y declara su
#     tipo según cómo lo hayan lanzado: mirar sólo `Type=wayland` lo dejaría
#     afuera y el mensaje taparía una pantalla que estaba bien.
#   - **Una sesión del asiento que todavía no es gráfica también cuenta**, y
#     esta concesión es la que faltaba. La sesión en vivo la abre greetd por
#     PAM y nace con `Type=tty`: recién pasa a `wayland` cuando el compositor
#     se registra. Medido en el ISO del 14/09/2026 arrancando en una máquina
#     virtual: la sesión aparece a los 51 s y no es `wayland` hasta los 137 s.
#     O sea que durante ochenta y seis segundos hay una sesión viva, del
#     asiento, abriendo el escritorio, y la versión anterior la contaba como
#     «no hay nada».
#   - Se pregunta varias veces, y durante bastante más de lo que tarda un
#     arranque bueno. Ver `RONDAS`.
set -u

# Cuánto se mira antes de dar el escritorio por perdido.
#
# Doce rondas de cinco segundos: un minuto, encima de los noventa del
# temporizador. El arranque más lento que se midió llegó a la sesión gráfica a
# los 137 s, así que esto cubre hasta los 150 s y deja margen.
#
# Alargarlo sale barato —lo único que se retrasa es un mensaje de error— y
# acortarlo sale carísimo, porque equivocarse acá fue lo que dejó al ISO sin
# escritorio durante semanas.
RONDAS=12
PAUSA=5

# Si greetd sigue vivo, todavía hay alguien intentando.
#
# No alcanza por sí solo —greetd puede quedarse activo con el saludador adentro
# y la pantalla negra— pero sí sirve para no confundir «tarda» con «se rindió»,
# que es de lo que se trata acá.
sigue_intentando() {
    systemctl is-active --quiet greetd.service
}

hay_algo() {
    local id datos
    while read -r id _; do
        [ -n "$id" ] || continue
        datos=$(loginctl show-session "$id" -p Seat -p Type -p Class 2>/dev/null) || continue
        case "$datos" in
            *Seat=seat0*) ;;
            *) continue ;;
        esac
        case "$datos" in
            # Ya hay pantalla.
            *Type=wayland*|*Type=x11*|*Class=greeter*) return 0 ;;
        esac
        # Hay una sesión del asiento que todavía no dice ser gráfica. Si greetd
        # sigue en pie, es el escritorio abriéndose: la sesión nace `Type=tty` y
        # cambia cuando el compositor se registra.
        sigue_intentando && return 0
    done < <(loginctl list-sessions --no-legend 2>/dev/null)
    return 1
}

for _ in $(seq "$RONDAS"); do
    hay_algo && exit 1
    sleep "$PAUSA"
done

exit 0
