// Autorización sin preguntar para el instalador, **sólo en el medio live**.
//
// Este archivo lo envía la ISO en su capa `airootfs`, no el paquete
// `vasak-installer`: en un sistema instalado, tomar privilegios de root para
// particionar discos tiene que pedir autenticación, y de eso se encarga el
// `auth_admin` de la acción.
//
// En el medio live hace falta porque el usuario `vasak` no tiene contraseña —es
// una cuenta de autologin—, así que un diálogo de autenticación sería un
// diálogo que nadie puede contestar y el instalador no abriría nunca.
//
// El plugin de archinstall lo borra del sistema instalado (`RASTROS_DEL_LIVE`).
// Si sobreviviera, cualquiera del grupo `wheel` con una sesión abierta podría
// lanzar un proceso root sin autenticarse.
polkit.addRule(function (action, subject) {
    if (action.id === "ar.net.vasak.installer.run-helper" && subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
